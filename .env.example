# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/erp_awesomely?schema=public"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Google OAuth — https://console.cloud.google.com/
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Microsoft Entra ID — https://portal.azure.com/
AUTH_MICROSOFT_ENTRA_ID=""
AUTH_MICROSOFT_ENTRA_SECRET=""
AUTH_MICROSOFT_ENTRA_TENANT_ID="common"

# Comma-separated emails allowed to edit SSO allowlist in Configuración (default: jaume@somosgigson.com)
SSO_ALLOWLIST_ADMIN_EMAILS=""

# ─── Cron ─────────────────────────────────────────────────────────────────────
# Secret to authenticate Vercel cron calls — generate with: openssl rand -base64 32
CRON_SECRET=""

# ─── Giro (plan 28-ago, F3 — conciliación horas aprobadas ↔ facturas) ─────────
# Instancia de Giro de la que leer coste aprobado por proyecto. La API key de cada
# organización se guarda por workspace Jira (JiraWorkspace.giroApiKey), no aquí: un
# workspace puede pertenecer a una org de Giro distinta de otro.
GIRO_BASE_URL="https://giro.tu-dominio.com"

# ─── Sincronización con Holded ────────────────────────────────────────────────
# Versión del API de Holded: "v2" (recomendado) o vacío para v1.
HOLDED_API_VERSION=v2

# Primer año con datos reales en Holded. El sync COMPLETO relee año a año desde
# aquí: poner un año anterior al primer ejercicio real gasta llamadas de API para
# no traer nada. Por defecto 2020 — ajústalo al alta real de la sociedad.
HOLDED_SYNC_FROM_YEAR=2020

# Días que relee el sync incremental (el diario). 60 cubre facturas introducidas
# con retraso; subirlo aumenta el número de llamadas proporcionalmente.
HOLDED_INCREMENTAL_LOOKBACK_DAYS=60

# Minutos de enfriamiento entre sincronizaciones disparadas por el webhook de
# Holded. 0 lo desactiva (un sync por cada evento — cuidado con la cuota).
HOLDED_WEBHOOK_MIN_INTERVAL_MINUTES=10
