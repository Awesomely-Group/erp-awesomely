generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth (NextAuth) ───────────────────────────────────────────────────────────

/// Rol de acceso (Growth, revisión 2026-09-18): ADMIN ve todo el ERP igual que hoy
/// (es el valor por defecto, para no romper el acceso de nadie que ya existía antes
/// de este campo); COMERCIAL solo ve la sección Growth (CRM, Campañas, sus propias
/// comisiones) — ver guard en src/proxy.ts y src/lib/roles.ts.
enum UserRole {
  ADMIN
  COMERCIAL

  @@map("user_role")
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  emailVerified DateTime?
  image         String?
  role          UserRole   @default(ADMIN)
  accounts      Account[]
  sessions      Session[]
  auditLogs     AuditLog[]
  apiKeys       ApiKey[]

  ownedLeads      CrmLead[]           @relation("CrmLeadOwner")
  ownedAccounts   CrmAccount[]        @relation("CrmAccountOwner")
  leadStageEvents CrmLeadStageEvent[]
  commissions     Commission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

/// Emails allowed to complete SSO (Google / Microsoft). Managed in Configuración.
model SsoAllowedEmail {
  id              String   @id @default(cuid())
  email           String   @unique
  createdAt       DateTime @default(now())
  createdByUserId String?

  @@map("sso_allowed_emails")
}

// ─── Companies ─────────────────────────────────────────────────────────────────

model Company {
  id           String  @id @default(cuid())
  name         String
  holdedApiKey String
  currency     String  @default("EUR")
  active       Boolean @default(true)

  invoices            Invoice[]
  suppliers           Supplier[]
  syncLogs            SyncLog[]
  proformas           Proforma[]
  budgets             Budget[]
  journalEntryLines   JournalEntryLine[]
  manualPayments      InvoicePayment[]
  forecasts           Forecast[]
  forecastRecurrences ForecastRecurrence[]
  employees           Employee[]
  salaryRecords       SalaryRecord[]
  crmAccounts         CrmAccount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("companies")
}

// ─── Jira Workspaces & Projects ────────────────────────────────────────────────

enum ProjectStatus {
  NOT_STARTED
  ONGOING
  PAUSED
  DONE
  ARCHIVED

  @@map("project_status")
}

model JiraWorkspace {
  id            String  @id @default(cuid())
  name          String
  domain        String
  email         String
  apiToken      String
  tempoApiToken String?
  active        Boolean @default(true)

  /// Org de Giro de la que leer coste aprobado por proyecto (plan 28-ago, F3 —
  /// conciliación horas aprobadas ↔ facturas). Guardados en claro, mismo criterio
  /// que `apiToken`/`tempoApiToken` de este mismo modelo — no es el paso 3 completo
  /// del Bloque E (eso sustituiría Tempo entero); es solo lo mínimo para que F3
  /// pueda llamar a `GET /api/v1/project-cost` de Giro.
  giroOrgSlug String?
  giroApiKey  String?

  projects JiraProject[]
  syncLogs SyncLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("jira_workspaces")
}

model JiraProject {
  id          String        @id @default(cuid())
  jiraId      String
  jiraKey     String
  name        String
  workspaceId String
  workspace   JiraWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  active      Boolean       @default(true)
  status      ProjectStatus @default(NOT_STARTED)

  /// Proyecto equivalente en Giro, para F3 (conciliación) — mismo campo que
  /// propone el Bloque E paso 1, adoptado aquí de forma aislada sin el resto de la
  /// migración (Tempo sigue siendo la fuente para todo lo demás).
  giroProjectId String? @unique

  /// Cliente al que pertenece el proyecto (portal de cliente, 2026-09-20). Es el único
  /// camino de "cliente X" → "sus bolsas de horas": `JiraProject` no tenía ningún
  /// vínculo con el cliente, y lo único que quedaba era inferirlo por las proformas
  /// clasificadas a mano (`classifyProforma`) — un proyecto cuya proforma nadie
  /// clasificó daría un saldo de CERO, que es un número equivocado y no un error.
  /// Nullable: hay proyectos internos, y uno sin cliente no sale en ningún portal.
  crmAccountId String?
  crmAccount   CrmAccount? @relation(fields: [crmAccountId], references: [id], onDelete: SetNull)

  // Tipos de proyecto (no exclusivos entre sí)
  isPrecioCerrado Boolean @default(false)
  isBolsasHoras   Boolean @default(false)
  isFeeRegular    Boolean @default(false)

  // Precio cerrado
  fixedPrice          Decimal?
  budgetedHours       Float?
  fixedPriceInvoiceId String?
  fixedPriceInvoice   Invoice? @relation("FixedPriceInvoice", fields: [fixedPriceInvoiceId], references: [id], onDelete: SetNull)

  classifications            Classification[]
  userRoles                  ProjectUserRole[]
  proformas                  Proforma[]
  forecasts                  Forecast[]
  forecastRecurrences        ForecastRecurrence[]
  hourBuckets                HourBucket[]
  regularFeeEntries          RegularFeeEntry[]
  issueHourBucketAssignments IssueHourBucketAssignment[]
  budgets                    Budget[]
  hoursSnapshot              ProjectHoursSnapshot?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jiraId, workspaceId])
  @@index([workspaceId])
  @@index([status])
  @@index([fixedPriceInvoiceId])
  @@index([crmAccountId])
  @@map("jira_projects")
}

model HourBucket {
  id             String       @id @default(cuid())
  projectId      String
  project        JiraProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  roleId         String
  role           RoleTemplate @relation(fields: [roleId], references: [id], onDelete: Restrict)
  code           String?      @unique
  totalHours     Float
  alertThreshold Float        @default(0.8)
  active         Boolean      @default(true)
  startDate      DateTime?
  endDate        DateTime?
  invoiceId      String?
  invoice        Invoice?     @relation("HourBucketInvoice", fields: [invoiceId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  issueAssignments IssueHourBucketAssignment[]
  consumption      HourBucketConsumption?

  @@index([projectId])
  @@index([invoiceId])
  @@map("hour_buckets")
}

model IssueHourBucketAssignment {
  id             String      @id @default(cuid())
  projectId      String
  project        JiraProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issueKey       String
  issueNumericId Int
  hourBucketId   String
  hourBucket     HourBucket  @relation(fields: [hourBucketId], references: [id], onDelete: Cascade)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([projectId, issueKey])
  @@index([projectId])
  @@index([hourBucketId])
  @@index([issueNumericId])
  @@map("issue_hour_bucket_assignments")
}

/// Foto del consumo de una bolsa, recalculada por el cron `/api/sync/hours`.
///
/// El portal de cliente no puede pedir las horas en caliente: `GET /api/v1/worklogs` de
/// Giro no pagina ni acepta límite —el rango de fechas es el único freno— y
/// `docs/consumo-api-holded.md` es la crónica de haber perdido ya esta pelea con Holded.
/// Tabla propia y no dos columnas en `HourBucket` a propósito: allí `updatedAt` pasaría a
/// significar "corrió el cron" en vez de "alguien tocó la bolsa".
model HourBucketConsumption {
  bucketId String     @id
  bucket   HourBucket @relation(fields: [bucketId], references: [id], onDelete: Cascade)

  /// Horas que consumen saldo: facturables, aprobadas y dentro de la ventana de la bolsa.
  consumedHours        Float @default(0)
  /// Imputadas a esta bolsa pero con el parte aún sin aprobar. No restan saldo; se
  /// enseñan aparte para que al cliente no le baje de golpe cuando se aprueben.
  pendingApprovalHours Float @default(0)

  computedAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("hour_bucket_consumptions")
}

/// Lo que el cron no pudo repartir en ninguna bolsa del proyecto, y si la última pasada
/// funcionó. `lastError` existe para que una caída de Giro se vea como "no pudimos
/// actualizar" y nunca como un consumo de cero recién calculado.
model ProjectHoursSnapshot {
  projectId String      @id
  project   JiraProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  pendingAttributionHours Float   @default(0)
  nonBillableHours        Float   @default(0)
  /// Desde qué día se pidieron los partes, para poder interpretar las cifras de arriba.
  worklogFloorDate        String
  /// "GIRO" | "TEMPO" — de dónde salieron estas horas. Durante la convivencia importa.
  source                  String
  lastError               String?

  computedAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("project_hours_snapshots")
}

model RegularFeeEntry {
  id               String        @id @default(cuid())
  projectId        String
  project          JiraProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  roleId           String?
  role             RoleTemplate? @relation(fields: [roleId], references: [id], onDelete: SetNull)
  label            String
  monthlyFee       Decimal
  maxHoursPerMonth Float
  active           Boolean       @default(true)
  invoiceId        String?
  invoice          Invoice?      @relation("RegularFeeInvoice", fields: [invoiceId], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([projectId])
  @@index([roleId])
  @@index([invoiceId])
  @@map("regular_fee_entries")
}

// ─── Invoices ──────────────────────────────────────────────────────────────────

enum InvoiceType {
  SALE
  PURCHASE
}

enum InvoiceStatus {
  PENDING
  PARTIAL
  CLASSIFIED
  SIN_MARCA
}

enum InvoiceRecurrence {
  PUNTUAL
  MENSUAL
  ANUAL
  EXTRAORDINARIO
}

model Invoice {
  id           String        @id @default(cuid())
  holdedId     String
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  type         InvoiceType
  holdedStatus Int?
  status       InvoiceStatus @default(PENDING)

  number          String?
  counterparty    String?
  holdedContactId String?

  date    DateTime
  dueDate DateTime?

  currency    String  @default("EUR")
  fxRateToEur Decimal @default(1)
  subtotal    Decimal @default(0)
  tax         Decimal @default(0)
  total       Decimal @default(0)
  totalEur    Decimal @default(0)

  // Brand from Holded tags (mapped to readable name)
  marca String?

  // Recurrence classification (inferred for PURCHASE, manual for SALE)
  recurrence InvoiceRecurrence?

  // Mes contable al que pertenece la factura (primer día del mes; por defecto el mes de date)
  accountingMonth DateTime?

  // Payment tracking (synced from Holded)
  paymentsTotal   Decimal @default(0)
  paymentsPending Decimal @default(0)

  // Null = active in Holded; DateTime = detected as removed on that date (kept for user data)
  removedFromHoldedAt DateTime?

  // Source document this invoice was created from, per Holded's `from` field (only exposed
  // on the per-document detail endpoint, GET /invoices/{id} — not on the list endpoint).
  // Cached here so we only need to fetch the detail endpoint once per invoice.
  sourceDocumentHoldedId String?
  sourceDocumentType     String? // raw Holded value, e.g. "proform"
  sourceDocumentChecked  Boolean @default(false)

  lines              InvoiceLine[]
  auditLogs          AuditLog[]
  erpPayments        InvoicePayment[]
  verifications      SupplierVerification[]
  hourBuckets        HourBucket[]           @relation("HourBucketInvoice")
  fixedPriceProjects JiraProject[]          @relation("FixedPriceInvoice")
  regularFeeEntries  RegularFeeEntry[]      @relation("RegularFeeInvoice")
  sourceProformas    Proforma[]             @relation("ProformaInvoiceLink")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([holdedId, companyId])
  @@index([companyId])
  @@index([companyId, date])
  @@index([companyId, holdedContactId])
  @@index([date])
  @@index([accountingMonth])
  @@index([marca])
  @@index([status, type])
  @@map("invoices")
}

model InvoicePayment {
  id             String        @id @default(cuid())
  invoiceId      String?
  invoice        Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  // Pago ligado a una nómina (SalaryRecord) en vez de a una factura — mutuamente
  // excluyente con invoiceId en la práctica, mismo mecanismo (registerPayment /
  // markManualPaymentPaid generalizados para aceptar uno u otro).
  salaryRecordId String?
  salaryRecord   SalaryRecord? @relation(fields: [salaryRecordId], references: [id], onDelete: Cascade)
  amount         Decimal
  // Ligado a factura: siempre se rellena al crearse (pago ya realizado, igual que
  // antes). Suelto (invoiceId null): queda en null hasta que se marca como pagado
  // (markManualPaymentPaid) — mientras tanto es un pago PENDIENTE, visible en la
  // misma lista de Pagos/Cobros pendientes que las facturas.
  paidAt         DateTime?
  paidBy         String?
  // Solo se usa en la rama suelta y pendiente: fecha prevista de pago/cobro,
  // equivalente al "Vencimiento" de una factura mientras no se marca pagado.
  dueDate        DateTime?
  notes          String?
  // IBAN del beneficiario/contraparte del pago — solo se pide (y persiste) en la
  // rama suelta del formulario ("Sin factura asociada"), texto libre (E14,
  // 2026-09-15): no hay contacto Holded del que sacarlo como sí pasa con las
  // facturas (ver contactIban en payments/page.tsx).
  iban           String?

  // Solo se rellenan cuando invoiceId es null (pago suelto, sin factura asociada).
  // Replican a propósito la forma de clasificación de Forecast, para que
  // cashflow-data.ts pueda escoger/atribuir estos pagos igual que ya hace con
  // los forecasts (ver cashflowScopeConditions en src/lib/org.ts). La
  // obligatoriedad (accountMappingId cuando es suelto) se valida en
  // createManualPayment, no a nivel de BD.
  direction        PaymentDirection?
  companyId        String?
  company          Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  marca            String?
  accountMappingId String?
  accountMapping   AccountMapping?   @relation(fields: [accountMappingId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@index([salaryRecordId])
  @@index([paidAt])
  @@index([dueDate])
  @@index([direction])
  @@index([companyId])
  @@index([accountMappingId])
  @@map("invoice_payments")
}

model InvoiceLine {
  id           String  @id @default(cuid())
  invoiceId    String
  invoice      Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  holdedLineId String?

  name        String
  description String?
  quantity    Decimal @default(1)
  unitPrice   Decimal @default(0)
  subtotal    Decimal @default(0)
  tax         Decimal @default(0)
  total       Decimal @default(0)
  totalEur    Decimal @default(0)

  accountingAccount     String?
  accountingAccountName String?
  notes                 String?

  sortOrder Int @default(0)

  classification Classification?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@map("invoice_lines")
}

// ─── Classification ────────────────────────────────────────────────────────────

enum ClassificationStatus {
  CLASSIFIED
  IGNORED
}

model Classification {
  id            String               @id @default(cuid())
  invoiceLineId String               @unique
  invoiceLine   InvoiceLine          @relation(fields: [invoiceLineId], references: [id], onDelete: Cascade)
  projectId     String?
  project       JiraProject?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  budgetId      String?
  budget        Budget?              @relation(fields: [budgetId], references: [id], onDelete: SetNull)
  marca         String?
  status        ClassificationStatus @default(CLASSIFIED)
  notes         String?

  classifiedBy String?
  reviewedBy   String?
  approvedBy   String?
  classifiedAt DateTime?
  reviewedAt   DateTime?
  approvedAt   DateTime?

  auditLogs AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([budgetId])
  @@index([status])
  @@map("classifications")
}

// ─── Exchange Rates ────────────────────────────────────────────────────────────

model ExchangeRate {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  currency  String
  rateToEur Decimal

  @@unique([date, currency])
  @@map("exchange_rates")
}

// ─── Audit Log ─────────────────────────────────────────────────────────────────

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  CLASSIFY
  REVIEW
  APPROVE
}

model AuditLog {
  id            String      @id @default(cuid())
  userId        String?
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action        AuditAction
  entityType    String
  entityId      String
  previousValue Json?
  newValue      Json?

  invoiceId        String?
  invoice          Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  classificationId String?
  classification   Classification? @relation(fields: [classificationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([invoiceId])
  @@index([classificationId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Supplier Verification ────────────────────────────────────────────────────

/// Proveedor sincronizado desde contactos Holded tipo "supplier", enriquecido con datos ERP.
model Supplier {
  id              String   @id @default(cuid())
  holdedContactId String
  companyId       String?
  company         Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name            String

  hourlyRate Decimal?
  tipo       SupplierTipo?

  defaultRoleId String?
  defaultRole   SupplierRole? @relation("SupplierDefaultRole", fields: [defaultRoleId], references: [id], onDelete: SetNull)

  isPartner Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jiraUsers           SupplierJiraUser[]
  roles               SupplierRole[]
  verifications       SupplierVerification[]
  forecasts           Forecast[]
  forecastRecurrences ForecastRecurrence[]

  @@unique([holdedContactId, companyId])
  @@index([companyId])
  @@map("suppliers")
}

model SupplierJiraUser {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  accountId  String
  createdAt  DateTime @default(now())

  @@unique([supplierId, accountId])
  @@map("supplier_jira_users")
}

model SupplierRole {
  id          String   @id @default(cuid())
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name        String
  ratePerHour Decimal
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  verifications       SupplierVerification[]
  defaultForSuppliers Supplier[]             @relation("SupplierDefaultRole")

  @@index([supplierId])
  @@map("supplier_roles")
}

model ProjectUserRole {
  id            String       @id @default(cuid())
  projectId     String
  project       JiraProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  jiraAccountId String
  /// Email con el que esa misma persona imputa en Giro (portal de cliente, 2026-09-20).
  /// Giro devuelve `authorEmail` en sus partes, nunca el `accountId` de Jira, así que sin
  /// esto el reparto por rol no funciona al cambiar la fuente de horas. Para la gente
  /// importada y no casada, Giro usa un email sombra del que el accountId se recupera
  /// parseando; para la registrada de forma nativa no hay más camino que este campo.
  giroUserEmail String?
  roleId        String
  role          RoleTemplate @relation(fields: [roleId], references: [id], onDelete: Cascade)
  ratePerHour   Decimal?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([projectId, jiraAccountId])
  @@index([projectId])
  @@map("project_user_roles")
}

/// Catálogo global de roles de proveedor, gestionable desde Configuración.
model RoleTemplate {
  id          String  @id @default(cuid())
  name        String
  color       String  @default("gray")
  ratePerHour Decimal @default(0)
  active      Boolean @default(true)

  hourBuckets       HourBucket[]
  projectUserRoles  ProjectUserRole[]
  regularFeeEntries RegularFeeEntry[]
  budgetLines       BudgetLine[]
  roleRates         RoleRate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("role_templates")
}

enum SupplierTipo {
  SERVICIOS
  HERRAMIENTAS

  @@map("supplier_tipo")
}

enum VerificationStatus {
  PENDING
  HOURS_CAPTURED
  INVOICE_RECEIVED
  PERIOD_MISMATCH
  VERIFIED_MISMATCH
  VERIFIED_OK
  APPROVED

  @@map("verification_status")
}

model SupplierVerification {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  roleId String?
  role   SupplierRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  periodStart DateTime
  periodEnd   DateTime

  tempoHours     Float?
  expectedAmount Decimal?
  capturedAt     DateTime?

  invoiceId      String?
  invoice        Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  invoicedAmount Decimal?

  invoiceServicePeriodStart DateTime?
  invoiceServicePeriodEnd   DateTime?
  periodMismatch            Boolean?

  status     VerificationStatus @default(PENDING)
  verifiedBy String?
  verifiedAt DateTime?
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([supplierId, periodStart, periodEnd])
  @@index([invoiceId])
  @@index([status])
  @@map("supplier_verifications")
}

// ─── Sync Logs ─────────────────────────────────────────────────────────────────

enum SyncSource {
  HOLDED
  JIRA
}

enum SyncResult {
  SUCCESS
  PARTIAL
  ERROR
  // Ejecución abierta: la fila se crea al empezar y se cierra al terminar. Una fila
  // que se queda en RUNNING es un sync que murió por el camino (ver src/lib/sync.ts).
  RUNNING
}

model SyncLog {
  id             String         @id @default(cuid())
  source         SyncSource
  result         SyncResult
  companyId      String?
  company        Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  workspaceId    String?
  workspace      JiraWorkspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  invoicesSynced Int            @default(0)
  projectsSynced Int            @default(0)
  errorMessage   String?
  details        Json?
  triggeredBy    String?
  startedAt      DateTime
  finishedAt     DateTime?

  @@index([companyId])
  @@index([workspaceId])
  @@index([source, startedAt])
  @@map("sync_logs")
}

// ─── Proformas (Holded) ───────────────────────────────────────────────────────

model Proforma {
  id        String  @id @default(cuid())
  holdedId  String
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  number          String?
  counterparty    String?
  holdedContactId String?
  holdedStatus    Int?

  // Link to the invoice this proforma was converted into. Set either by
  // linkProformasByHoldedRelation() (confidence "holded_link", from Holded's real
  // proforma→invoice relation) or manually by a user (confidence "manual").
  invoiceId             String?
  invoice               Invoice? @relation("ProformaInvoiceLink", fields: [invoiceId], references: [id], onDelete: SetNull)
  invoiceLinkedManually Boolean  @default(false)
  invoiceLinkConfidence String? // "holded_link" | "amount_match" | "manual"

  date    DateTime
  dueDate DateTime?

  currency    String  @default("EUR")
  fxRateToEur Decimal @default(1)
  subtotal    Decimal @default(0)
  tax         Decimal @default(0)
  total       Decimal @default(0)
  totalEur    Decimal @default(0)

  description String?
  tags        String[]

  marca     String?
  projectId String?
  project   JiraProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  notes     String?

  paymentTerms PaymentTerm[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([holdedId, companyId])
  @@index([companyId])
  @@index([companyId, date])
  @@index([companyId, holdedContactId])
  @@index([marca])
  @@index([invoiceId])
  @@map("proformas")
}

// ─── Previsiones ERP ─────────────────────────────────────────────────────────

enum ForecastType {
  INCOME
  EXPENSE

  @@map("forecast_type")
}

// ─── Pagos manuales ──────────────────────────────────────────────────────────

enum PaymentDirection {
  INCOME
  EXPENSE

  @@map("payment_direction")
}

enum ForecastFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY

  @@map("forecast_frequency")
}

/// Plantilla de recurrencia para previsiones manuales. No representa un importe propio
/// que se sume en cashflow — únicamente describe cómo se generaron los `Forecast` hijos
/// (creados todos de golpe al crear la recurrencia, ver recurrence-actions.ts).
model ForecastRecurrence {
  id          String            @id @default(cuid())
  frequency   ForecastFrequency
  startDate   DateTime
  endDate     DateTime?
  occurrences Int?

  type             ForecastType
  marca            String?
  companyId        String?
  company          Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  projectId        String?
  project          JiraProject?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  accountMappingId String?
  accountMapping   AccountMapping? @relation(fields: [accountMappingId], references: [id], onDelete: SetNull)
  supplierId       String?
  supplier         Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  description       String?
  amountOptimistic  Decimal
  amountPessimistic Decimal

  createdBy String?
  updatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  forecasts Forecast[]

  @@index([marca])
  @@index([companyId])
  @@map("forecast_recurrences")
}

model Forecast {
  id        String       @id @default(cuid())
  month     DateTime
  type      ForecastType
  marca     String?
  companyId String?
  company   Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  projectId String?
  project   JiraProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  accountMappingId String?
  accountMapping   AccountMapping? @relation(fields: [accountMappingId], references: [id], onDelete: SetNull)
  supplierId       String?
  supplier         Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  description       String?
  amountOptimistic  Decimal
  amountPessimistic Decimal

  recurrenceId String?
  recurrence   ForecastRecurrence? @relation(fields: [recurrenceId], references: [id], onDelete: Cascade)
  isPaused     Boolean             @default(false)

  createdBy String?
  updatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([month])
  @@index([marca])
  @@index([companyId])
  @@index([recurrenceId])
  @@index([accountMappingId])
  @@index([supplierId])
  @@map("forecasts")
}

// ─── Presupuestos ─────────────────────────────────────────────────────────────

enum BudgetType {
  PRECIO_CERRADO
  BOLSA_DE_HORAS
  FEE_REGULAR

  @@map("budget_type")
}

enum BudgetRegion {
  UK
  US
  EU
  OTHER

  @@map("budget_region")
}

enum BudgetStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED

  @@map("budget_status")
}

enum BudgetTemplate {
  SOLUTIONS
  TROUPE

  @@map("budget_template")
}

enum PaymentTermValueType {
  PERCENTAGE
  AMOUNT

  @@map("payment_term_value_type")
}

enum BudgetLineType {
  ROL
  ACTIVIDAD

  @@map("budget_line_type")
}

model Budget {
  id        String       @id @default(cuid())
  // Nullable desde Growth/CRM (revisión 2026-09-18): un presupuesto puede originarse
  // en un CrmLead que todavía no tiene proyecto de Jira asignado (D7/F7). El alta
  // manual en /budgets sigue exigiendo un proyecto en el formulario (sin cambios de
  // UX ahí); solo el webhook de propuestas y los leads del CRM pueden dejarlo vacío.
  projectId String?
  project   JiraProject? @relation(fields: [projectId], references: [id], onDelete: Restrict)

  // Lead de Growth/CRM del que nace esta propuesta (D7/F7) — dispara la comisión
  // PROPOSAL_PERCENT al firmarse (ver src/app/api/webhooks/documenso/route.ts).
  crmLeadId String?
  crmLead   CrmLead? @relation(fields: [crmLeadId], references: [id], onDelete: SetNull)

  name           String
  type           BudgetType
  region         BudgetRegion   @default(EU)
  amount         Decimal
  currency       String         @default("EUR")
  estimatedHours Float?
  monthlyFee     Decimal?
  status         BudgetStatus   @default(DRAFT)
  template       BudgetTemplate @default(SOLUTIONS)
  startDate      DateTime?
  endDate        DateTime?
  notes          String?

  clientName      String?
  holdedContactId String?

  companyId      String?
  company        Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  holdedDocId    String?
  holdedSyncedAt DateTime?

  // ─── Integración de propuestas (gigsonapps.com / latroupeapps.com) ───────────
  // El presupuesto/propuesta se crea desde una plataforma externa por marca; estos
  // campos rastrean su origen, el contenido de la propuesta enviada a firma, y el
  // estado de la firma en Documenso. Ver docs/proposals-plan-v2.md.
  sourcePlatform      String? // "LT_TOOLS" | "GIGSONAPPS"
  externalRef         String? // uuid generado por la plataforma llamante (idempotencia)
  executiveSummary    String? // resumen ejecutivo de la propuesta
  paymentConditions   String? // condiciones de pago en texto libre
  validUntil          DateTime? // validez comercial de la propuesta
  sentAt              DateTime? // cuándo se envió a firmar
  documensoDocumentId Int?
  documensoStatus     String? // "DRAFT" | "SENT" | "VIEWED" | "SIGNED"

  lines           BudgetLine[]
  paymentTerms    PaymentTerm[]
  classifications Classification[]
  commissions     Commission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourcePlatform, externalRef])
  @@index([projectId])
  @@index([status])
  @@index([companyId])
  @@index([crmLeadId])
  @@map("budgets")
}

model BudgetLine {
  id       String         @id @default(cuid())
  budgetId String
  budget   Budget         @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  lineType BudgetLineType @default(ROL)
  roleId   String?
  role     RoleTemplate?  @relation(fields: [roleId], references: [id], onDelete: SetNull)

  // ROL fields
  phase          String?
  task           String?
  estimatedHours Float?
  pvpPerHour     Decimal?
  costPerHour    Decimal?

  // ACTIVIDAD fields
  concept   String?
  quantity  Decimal?
  unitPrice Decimal?

  // Configurador de propuesta (heredado de docs/proposals-plan.md) — opcional,
  // usado sobre todo por el catálogo de servicios de Gigson Solutions (tarifas
  // BUILD/DISCOVER); LaTroupe puede dejarlo vacío si su lógica de precios es otra.
  rateType     String? // "BUILD" | "DISCOVER"
  serviceType  String? // p.ej. "discovery" | "desarrollo" | "integracion" | "consultoria" | "devops" | "qa" | "pm" | "mantenimiento"
  deliverables String[] @default([])

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([budgetId])
  @@index([roleId])
  @@map("budget_lines")
}

model PaymentTerm {
  id          String               @id @default(cuid())
  budgetId    String
  budget      Budget               @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  order       Int
  valueType   PaymentTermValueType
  value       Decimal
  dueDate     DateTime?
  description String?

  proformaId String?
  proforma   Proforma? @relation(fields: [proformaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([budgetId])
  @@index([proformaId])
  @@map("payment_terms")
}

/// Tarifa PVP por rol y región de cliente. Gestiona el precio de venta (no el coste interno).
model RoleRate {
  id     String       @id @default(cuid())
  roleId String
  role   RoleTemplate @relation(fields: [roleId], references: [id], onDelete: Cascade)
  region BudgetRegion
  pvp    Decimal
  cost   Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roleId, region])
  @@index([roleId])
  @@map("role_rates")
}

// ─── API Keys ─────────────────────────────────────────────────────────────────

/// Claves de API para acceso programático (MCP, integraciones externas). El valor real
/// se muestra una sola vez al crearla; aquí se almacena únicamente el hash SHA-256.
model ApiKey {
  id          String    @id @default(cuid())
  name        String
  keyHash     String    @unique
  keyPrefix   String
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?

  @@map("api_keys")
}

// ─── Account Mappings ──────────────────────────────────────────────────────────

model AccountMapping {
  id            String  @id @default(cuid())
  tag           String  @unique
  description   String
  l1            String
  accountNumSL  String?
  accountNameSL String?
  accountNumOU  String?
  accountNameOU String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  forecasts           Forecast[]
  forecastRecurrences ForecastRecurrence[]
  payments            InvoicePayment[]

  @@map("account_mappings")
}

// ─── Journal Entry Lines (asientos contables Holded, excluidas facturas) ───────
//
// Almacena exclusivamente los apuntes contables que NO proceden de facturas de
// venta o compra (ya sincronizadas en Invoice). Esto incluye nóminas, amortizaciones,
// asientos manuales y entradas de banco sin factura asociada.
//
// amountEur = crédito − débito (signo convencional del P&L):
//   cuentas de gasto (6xx): debit > credit → amountEur < 0 (reduce resultado)
//   cuentas de ingreso (7xx): credit > debit → amountEur > 0 (suma a resultado)

model JournalEntryLine {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  // Claves de Holded para identificar el apunte de forma única
  holdedEntryId String // ID del asiento padre en Holded
  holdedLineIdx Int // posición (0-based) dentro de las líneas del asiento

  date            DateTime
  accountingMonth DateTime? // override manual del mes contable (futuro)
  description     String?
  account         String // código PGC numérico (e.g. "640" o "64000000")
  amountEur       Decimal // crédito − débito, en EUR

  originType String? // "payroll", "manual", "bank", "depreciation", null…

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, holdedEntryId, holdedLineIdx])
  @@index([companyId, date])
  @@index([companyId, accountingMonth])
  @@map("journal_entry_lines")
}

// ─── RRHH — Nóminas (Holded Team API: /v2/employees, /v2/salary-records) ───────
//
// Las nóminas las genera la gestoría fuera de Holded y se pasan por el OCR del
// módulo "Team" de Holded (app.holded.com/team/v2/payrolls/salary-record/...),
// NO son facturas de compra — viven en un módulo separado de la API de Holded
// (accounting:payrolls.read / team:employees.read), sincronizado aparte de
// invoices/purchases (E15, 2026-09-15). Se muestran mezcladas con las facturas
// en la lista de "Pagos pendientes" (PaymentInvoice.source === "payroll").

enum SalaryPaymentStatus {
  PENDING
  PAID
  PARTIALLY_PAID

  @@map("salary_payment_status")
}

model Employee {
  id               String  @id @default(cuid())
  companyId        String
  company          Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  holdedEmployeeId String
  fullName         String
  // IBAN del empleado, sincronizado desde Holded — se usa como IBAN del
  // beneficiario en la fila de Pagos, igual que contactIban para facturas.
  iban             String?
  isExEmployee     Boolean @default(false)

  salaryRecords SalaryRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, holdedEmployeeId])
  @@map("employees")
}

model SalaryRecord {
  id                   String    @id @default(cuid())
  companyId            String
  company              Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  holdedSalaryRecordId String
  employeeId           String?
  employee             Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  // Snapshot del nombre del empleado en el momento de la nómina (igual que hace
  // Holded) — sobrevive aunque se borre el Employee.
  employeeName         String
  // Fecha de devengo — no existe fecha de vencimiento en el API de Holded, se
  // usa esta como equivalente al "Vencimiento" de una factura en Pagos.
  date                 DateTime
  description          String?
  isDraft              Boolean   @default(false)

  totalPayable   Decimal
  paymentTotal   Decimal             @default(0)
  paymentPending Decimal             @default(0)
  paymentStatus  SalaryPaymentStatus

  lines       SalaryRecordLine[]
  erpPayments InvoicePayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, holdedSalaryRecordId])
  @@index([companyId, date])
  @@index([paymentStatus])
  @@map("salary_records")
}

/// Desglose por concepto de cada nómina, tal cual lo captura el OCR de Holded:
/// salary, tax, companytax, retention, extra, result, advance,
/// wage_garnishment, pago_delegado_it, salary_in_kind(...).
model SalaryRecordLine {
  id             String       @id @default(cuid())
  salaryRecordId String
  salaryRecord   SalaryRecord @relation(fields: [salaryRecordId], references: [id], onDelete: Cascade)
  type           String
  amount         Decimal
  description    String?

  @@index([salaryRecordId])
  @@map("salary_record_lines")
}

// ─── Growth: CRM (plan revisado 2026-09-18) ────────────────────────────────────
//
// A diferencia de Invoice/Proforma/Budget, estos modelos NO son un espejo de
// Holded — el CRM de Holded no se usa (decisión D4 revertida respecto al plan
// original). El ERP es el sistema de registro nativo del pipeline comercial;
// Holded se sigue usando solo para el contacto fiscal/proformas/facturas una vez
// el lead se convierte en propuesta (holdedContactId en CrmAccount, sin cambios
// en esa parte).

/// Canal de entrada de un lead (D7). Los 3 canales entran por el mismo endpoint
/// POST /api/webhooks/leads salvo MANUAL (alta desde el propio ERP).
enum CrmLeadSource {
  WEB_GIGSON
  WEB_LATROUPE
  APOLLO
  MANUAL
  REFERIDO
  OTRO

  @@map("crm_lead_source")
}

enum CrmStageChangeTrigger {
  MANUAL_DRAG
  WEBHOOK

  @@map("crm_stage_change_trigger")
}

enum CrmAccountLifecycle {
  LEAD
  QUALIFIED
  CUSTOMER
  CHURNED
  DISQUALIFIED

  @@map("crm_account_lifecycle")
}

enum CrmActivityType {
  NOTE
  CALL
  MEETING
  TASK

  @@map("crm_activity_type")
}

/// Origen del lead (revisión 2026-09-18, impacto plan Odoo): distingue base
/// instalada que se migra/amplía (INSIDE_OUT) de mercado abierto (OUTSIDE_IN) — el
/// deck de Odoo separa objetivos por ese mix, y LaTroupe necesita lo mismo para su
/// "tasa de referidos >50%".
enum CrmLeadOrigin {
  INSIDE_OUT
  OUTSIDE_IN
  REFERRAL
  INBOUND
  PARTNER

  @@map("crm_lead_origin")
}

/// Etapas del pipeline, propias del ERP (ya no las define Holded). Una lista por
/// marca — el seed inicial se confirma con el usuario antes de sembrarse (ver
/// scripts/seed-crm-stages.ts), no viene de ningún documento verificado en la
/// sesión que diseñó este módulo.
model CrmStage {
  id             String  @id @default(cuid())
  marca          String
  // Línea de negocio dentro de la marca (revisión 2026-09-18, impacto plan Odoo):
  // Gigson Solutions puede tener más de un embudo (p.ej. "INTEGRACIONES" vs "ODOO",
  // cada uno con sus propias etapas — la de Odoo incluye "Demo", que no existe en el
  // embudo actual). "GENERAL" es el valor por defecto para marcas con un único
  // funnel — no obliga a nadie a tener líneas de negocio para poder usar el CRM.
  lineOfBusiness String  @default("GENERAL")
  name           String
  order          Int
  isWon          Boolean @default(false)
  isLost         Boolean @default(false)

  leads      CrmLead[]
  fromEvents CrmLeadStageEvent[] @relation("StageEventFrom")
  toEvents   CrmLeadStageEvent[] @relation("StageEventTo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([marca, lineOfBusiness, order])
  @@index([marca, lineOfBusiness])
  @@map("crm_stages")
}

model CrmLead {
  id             String        @id @default(cuid())
  name           String
  marca          String
  // Ver comentario en CrmStage.lineOfBusiness — debe coincidir con la línea del
  // CrmStage al que apunta `stageId` (no hay constraint de BD que lo garantice, se
  // valida en el código que crea/mueve el lead).
  lineOfBusiness String        @default("GENERAL")
  source         CrmLeadSource

  contactName String?
  email       String?
  phone       String?
  amount      Decimal?

  // Mix inside-out/outside-in (plan Odoo) y pipeline por mercado (LaTroupe: UK/US/
  // ES/Nórdicos/Sudáfrica, porque su paid está segmentado así). `seats` es el nº de
  // usuarios propuestos — objetivo de la línea Odoo (~75 en el año 1).
  origin CrmLeadOrigin?
  market String?
  seats  Int?

  stageId String
  stage   CrmStage @relation(fields: [stageId], references: [id], onDelete: Restrict)

  // Nullable (revisión 2026-09-18): hoy no hay ningún usuario con rol COMERCIAL
  // asignado todavía (D8) — un lead entrante por webhook puede quedar "sin asignar"
  // hasta que un admin lo reparta, en vez de forzar un dueño ficticio.
  ownerId String?
  owner   User?   @relation("CrmLeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  accountId String?
  account   CrmAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  // Atribución de campaña (F2, para cruzar con Growth > Campañas más adelante).
  campaignSource String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?

  // Idempotencia de los 3 canales de entrada — único por origen (D7).
  externalRef String?

  // Checkbox manual (D9): cualifica al lead y habilita la comisión de 20€ por
  // reunión cerrada (ver CrmActivity.type MEETING + completedAt).
  qualified Boolean @default(false)

  expectedCloseDate DateTime?
  probability       Int?
  notes             String?

  // Se rellena al ganar el lead y convertirlo en proyecto real.
  projectId String?

  stageEvents CrmLeadStageEvent[]
  activities  CrmActivity[]
  budgets     Budget[]
  commissions Commission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, externalRef])
  @@index([marca])
  @@index([stageId])
  @@index([ownerId])
  @@index([accountId])
  @@index([source])
  @@map("crm_leads")
}

/// Historial de cambios de etapa — siempre originado en el ERP (ya no hay
/// distinción SYNC/ERP del plan original porque no hay sync con Holded). Sin
/// esto no hay ciclo de venta medible (KPIs de Growth).
model CrmLeadStageEvent {
  id     String  @id @default(cuid())
  leadId String
  lead   CrmLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  fromStageId String?
  fromStage   CrmStage? @relation("StageEventFrom", fields: [fromStageId], references: [id], onDelete: SetNull)
  toStageId   String
  toStage     CrmStage  @relation("StageEventTo", fields: [toStageId], references: [id], onDelete: Restrict)

  trigger         CrmStageChangeTrigger @default(MANUAL_DRAG)
  changedByUserId String?
  changedByUser   User?                 @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  changedAt DateTime @default(now())

  @@index([leadId])
  @@index([changedAt])
  @@map("crm_lead_stage_events")
}

/// Cuenta de cliente canónica del ERP (no existe en Holded). `holdedContactId`
/// queda null hasta que se prepara la primera propuesta (D3, sin cambios).
model CrmAccount {
  id        String              @id @default(cuid())
  name      String
  domain    String?
  vatNumber String?
  lifecycle CrmAccountLifecycle @default(LEAD)
  marca     String?

  ownerId String?
  owner   User?   @relation("CrmAccountOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  companyId       String?
  company         Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  holdedContactId String?

  leads      CrmLead[]
  contacts   CrmContact[]
  activities CrmActivity[]
  projects   JiraProject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, holdedContactId])
  @@index([ownerId])
  @@map("crm_accounts")
}

model CrmContact {
  id        String     @id @default(cuid())
  accountId String
  account   CrmAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  name  String
  email String?
  phone String?
  role  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
  /// El portal de cliente resuelve qué cliente es por el email de la persona.
  @@index([email])
  @@map("crm_contacts")
}

model CrmActivity {
  id   String          @id @default(cuid())
  type CrmActivityType

  leadId    String?
  lead      CrmLead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  accountId String?
  account   CrmAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  title       String
  notes       String?
  dueDate     DateTime?
  completedAt DateTime?

  /// Referencia externa (ReadAI, hilo de Gmail…), fuera de alcance de este módulo.
  externalRef String?

  createdByUserId String?

  commission Commission?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([accountId])
  @@index([dueDate])
  @@map("crm_activities")
}

// ─── Growth: Comisiones (D9, solo LaTroupe de momento) ─────────────────────────

enum CommissionType {
  PROPOSAL_PERCENT
  QUALIFIED_MEETING

  @@map("commission_type")
}

enum CommissionStatus {
  PENDING
  CONFIRMED
  PAID
  CANCELLED

  @@map("commission_status")
}

/// Regla de comisión por marca. Genérico a propósito (D9): una marca sin fila
/// aquí, o con `active: false`, simplemente no genera comisiones — así se activa
/// Gigson en el futuro sin tocar código, solo insertando una fila.
model CommissionRule {
  marca                  String  @id
  proposalPercent        Decimal @default(10)
  qualifiedMeetingAmount Decimal @default(20)
  active                 Boolean @default(true)

  updatedAt DateTime @updatedAt

  @@map("commission_rules")
}

model Commission {
  id    String         @id @default(cuid())
  type  CommissionType
  marca String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  leadId String?
  lead   CrmLead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  // PROPOSAL_PERCENT: propuesta firmada que originó la comisión.
  budgetId String?
  budget   Budget? @relation(fields: [budgetId], references: [id], onDelete: SetNull)

  // QUALIFIED_MEETING: actividad de reunión completada que la originó. Única —
  // evita duplicados si la actividad se reabre/cierra varias veces.
  activityId String?      @unique
  activity   CrmActivity? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  // Snapshot de la regla en el momento del cálculo, para no recalcular mal si
  // luego cambia CommissionRule.
  baseAmount Decimal?
  rate       Decimal?
  amount     Decimal
  currency   String           @default("EUR")
  status     CommissionStatus @default(PENDING)

  triggeredAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([marca])
  @@index([status])
  @@map("commissions")
}

// ─── Growth: metas de KPI (revisión 2026-09-18, impacto plan Odoo) ─────────────

enum KpiTargetPeriodType {
  MONTH
  QUARTER
  YEAR

  @@map("kpi_target_period_type")
}

/// Meta configurable por métrica/marca/línea de negocio/periodo, transversal (no
/// solo CRM — sirve igual para métricas de entrega o financieras el día que se
/// construyan). Alimenta el semáforo Verde (≥100% meta) / Ámbar (70-99%) / Rojo
/// (<70%) de la rutina mensual comercial. Se edita en /settings — el ERP no asume
/// valores por defecto: las cifras del plan de activación de Odoo (88/44/22/9, 75
/// usuarios, ratio 3x) son una plantilla sin aprobar, no se siembran aquí.
model KpiTarget {
  id String @id @default(cuid())

  /// Identificador libre de la métrica (p.ej. "leads_mes", "demos_mes",
  /// "propuestas_enviadas", "ticket_medio", "win_rate") — sin enum cerrado a
  /// propósito, para no tener que migrar el schema cada vez que se añade una métrica
  /// nueva a src/lib/kpis/commercial.ts.
  metric String

  marca          String?
  lineOfBusiness String?

  periodType KpiTargetPeriodType
  /// "2026-09" (MONTH), "2026-Q3" (QUARTER) o "2026" (YEAR) — texto simple en vez de
  /// fechas para no tener que decidir a qué día del periodo apuntar.
  periodKey  String

  value Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([metric, marca, lineOfBusiness, periodType, periodKey])
  @@index([metric])
  @@map("kpi_targets")
}
